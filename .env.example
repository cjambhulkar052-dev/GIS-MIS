# Amber Partners Inventories API
# Provided by your POC at Amber. Without these, Find Rooms falls back to
# the built-in sample inventory automatically — see src/app/api/amber/inventories/route.ts.
AMBER_PARTNER_UUID=
AMBER_API_BASE_URL=https://base.amberstudent.com

# Supabase Auth
# From Project Settings > API. The publishable key is safe to expose client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — needed for the daily-sold-report cron job (bypasses RLS to write snapshots).
SUPABASE_SECRET_KEY=

# Daily Amber sold-property report
# CRON_SECRET protects /api/cron/daily-sold-report from public access — generate any random string.
# cron-job.org must call: https://<your-domain>/api/cron/daily-sold-report?secret=<CRON_SECRET>
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Comma-separated list of recipient emails, e.g. you@example.com,partner@example.com
DAILY_REPORT_RECIPIENTS=
